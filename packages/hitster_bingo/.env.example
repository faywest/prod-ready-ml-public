# Copy this file to .env (same folder) and fill in the values from
# https://developer.spotify.com/dashboard  ->  your app  ->  Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback
